---
import '../styles/global.css';
const { title = 'Cronache del Mondo', description = 'Atlante e cronache di un mondo fantasy.' } = Astro.props;
const current = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101716" />
    <title>{title} · Cronache del Mondo</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="topbar">
        <a class="brand" href={base}>
          <span class="brand-mark">✧</span>
          <span>CRONACHE DEL MONDO</span>
        </a>
        <nav class="nav" aria-label="Navigazione principale">
          <a href={base} aria-current={current === base ? 'page' : undefined}>Home</a>
          <a href={base + 'atlante/'} aria-current={current.includes('/atlante') ? 'page' : undefined}>Atlante</a>
          <a href={base + 'ambientazione/'} aria-current={current.includes('/ambientazione') ? 'page' : undefined}>Il mondo</a>
          <a href={base + 'campagna/'} aria-current={current.includes('/campagna') ? 'page' : undefined}>La campagna</a>
          <a href={base + 'master/'} aria-current={current.includes('/master') ? 'page' : undefined}>Master</a>
        </nav>
      </header>
      <slot />
      <footer class="site-footer">UN MONDO IN DIVENIRE · ENCICLOPEDIA DELL'AMBIENTAZIONE</footer>
    </div>
  </body>
</html>